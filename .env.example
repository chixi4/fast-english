# Copy to .env and fill in values.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MOCK=0

# Optional
APP_DB_PATH=data/app.db

# Optional: multi-user mode (recommended when enabling in-app login)
# Each logged-in username gets its own SQLite DB file in APP_USER_DB_DIR.
APP_MULTIUSER_BY_IDENTITY=1
APP_USER_DB_DIR=data/userdb

# Optional: local dev override (when login is disabled)
APP_DEV_USER_IDENTITY=

# Optional: in-app login/session
APP_REQUIRE_LOGIN=1
APP_AUTH_DB_PATH=data/auth.db
APP_AUTH_SECRET_KEY=change-me-long-random
APP_AUTH_COOKIE_NAME=vs_session
APP_AUTH_COOKIE_DAYS=30

# Optional: protect the whole site with HTTP Basic Auth (useful when sharing via a tunnel)
# If either user or pass is empty, auth is disabled.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASS=
APP_BASIC_AUTH_REALM=Vocabulary Study

# Optional: FSRS scheduling (0-1). Higher = more reviews, lower = more forgetting.
SRS_DESIRED_RETENTION=0.9
